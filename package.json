{
  "name": "@digimatrix-labs/citeflow",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "description": "Document-centered citations for humans and AI agents",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "citeflow": "./src/cli.js",
    "citeflow-mcp": "./src/mcp.js",
    "citeflow-agent": "./agent/main.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "mcp": "node src/mcp.js",
    "build:browser": "node scripts/build-browser.js",
    "preview:browser": "node scripts/preview-browser.js",
    "test:browser": "npm run build:browser && playwright test",
    "build:agent": "node scripts/build-agent.js",
    "agent": "node agent/main.js"
  },
  "dependencies": {
    "@citation-js/core": "0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "0.7.22",
    "@citation-js/plugin-ris": "^0.7.21",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@noble/hashes": "^1.8.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@xmldom/xmldom": "^0.9.12",
    "cheerio": "1.1.2",
    "citeproc": "2.4.63",
    "ipaddr.js": "2.3.0",
    "jszip": "3.10.1",
    "zod": "^3.25.0",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6"
  }
}
